{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://singapore-gp-dashboard.vercel.app",
          "http://localhost:5173",
          "http://localhost:5175",
          "http://localhost:5176",
          "http://127.0.0.1:5173",
          "http://127.0.0.1:5175",
          "http://127.0.0.1:5176"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["Range"]
      },
      "exposeHeaders": ["Content-Length", "ETag"],
      "maxAgeSeconds": 86400
    }
  ]
}
